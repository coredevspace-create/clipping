# Base de données (SQLite en local, PostgreSQL en production : changer aussi le provider dans prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions (32+ caractères aléatoires) : openssl rand -base64 32
AUTH_SECRET="change-moi-avec-une-longue-chaine-aleatoire"

# URL publique de l'app (liens d'invitation)
APP_URL="http://localhost:3000"

# Secret pour appeler /api/cron/refresh-views (header Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="change-moi"

# YouTube Data API v3 (suivi réel des vues YouTube Shorts)
YOUTUBE_API_KEY=""

# Mode "demo" : simule la croissance des vues TikTok / Instagram / X tant que leurs API ne sont pas branchées.
# Ne JAMAIS activer en production.
VIEWS_DEMO_MODE="true"
