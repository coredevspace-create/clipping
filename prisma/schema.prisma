// PostgreSQL (Neon en production). Les noms de variables correspondent à ceux créés
// automatiquement par l'intégration Neon de Vercel.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // connexion « poolée » utilisée par l'app
  directUrl = env("DATABASE_URL_UNPOOLED") // connexion directe utilisée pour les migrations
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String
  passwordHash String
  /// CREATOR | CLIPPER : détermine l'accueil et la navigation (un compte peut faire les deux)
  role         String             @default("CREATOR")
  /// Code personnel à mettre dans la description des vidéos pour prouver qu'elles sont à soi (ex. cs7k2p)
  verifyCode   String?            @unique
  createdAt    DateTime           @default(now())
  workspaces   Workspace[]
  memberships  Membership[]
  profile      ClipperProfile?
  applications Application[]
  invitations  Invitation[]
  messages     Message[]
  accounts     ConnectedAccount[]
}

/// Compte TikTok / Instagram / YouTube connecté par un clippeur (OAuth). Jetons chiffrés.
model ConnectedAccount {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       String // TIKTOK | INSTAGRAM | YOUTUBE
  externalUserId String
  username       String
  accessToken    String // chiffré (AES-256-GCM)
  refreshToken   String? // chiffré
  expiresAt      DateTime?
  scopes         String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, platform])
  @@index([platform, externalUserId])
}

/// L'annonce d'un clippeur : visible par les créateurs dans l'annuaire.
model ClipperProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline  String
  bio       String
  /// Valeurs séparées par des virgules (voir NICHES / PLATFORM_LABELS)
  niches    String   @default("")
  platforms String   @default("")
  /// Liens vers des clips ou comptes, un par ligne
  portfolio String   @default("")
  /// Discord, Telegram… visible uniquement par les créateurs avec qui il est en relation
  contact   String?
  available Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// L'annonce d'un créateur (une par équipe) : visible par tous les clippeurs.
model Offer {
  id           String        @id @default(cuid())
  workspaceId  String        @unique
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title        String
  description  String
  niche        String
  platforms    String        @default("")
  requirements String?
  status       String        @default("OPEN") // OPEN | CLOSED
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

/// Candidature d'un clippeur à une annonce.
model Application {
  id        String   @id @default(cuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  status    String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt DateTime @default(now())

  @@unique([offerId, userId])
}

/// Invitation d'un créateur envoyée à un clippeur depuis l'annuaire.
model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  status      String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
}

/// L'équipe d'un fondateur (un produit / une campagne de clipping).
model Workspace {
  id                      String       @id @default(cuid())
  name                    String
  ownerId                 String
  owner                   User         @relation(fields: [ownerId], references: [id])
  inviteCode              String       @unique
  plan                    String       @default("STARTER") // STARTER | PRO | AGENCE
  /// URL du produit vers laquelle pointent les liens traqués des clippeurs
  productUrl              String?
  /// APP | GAME | WEB | DESKTOP | EXTENSION : type de produit (adapte le vocabulaire et le suivi)
  productType             String       @default("APP")
  appStoreUrl             String?
  playStoreUrl            String?
  /// « provider token » App Store Connect : permet de voir les téléchargements par clippeur (paramètre ct)
  appStoreProviderToken   String?
  /// Clé secrète de l'URL de conversion (inscriptions / achats envoyés par le produit)
  conversionKey           String       @default(cuid())
  /// Rémunération en centimes pour 1 000 vues
  cpmCents                Int          @default(100)
  /// Seuil minimum de vues pour qu'un clip soit rémunéré
  minViews                Int          @default(1000)
  /// Plafond de rémunération par clip, en centimes
  maxPayoutPerClipCents   Int          @default(10000)
  /// Délai avant qu'un clip non signalé soit validé automatiquement
  holdDays                Int          @default(7)
  /// Score de fraude (0-100) à partir duquel un clip est mis en quarantaine
  fraudThreshold          Int          @default(50)
  /// Exiger que le clippeur ait connecté son compte de la plateforme pour soumettre un clip
  requireVerifiedAccounts Boolean      @default(false)
  createdAt               DateTime     @default(now())
  memberships             Membership[]
  clips                   Clip[]
  sources                 Source[]
  payoutRuns              PayoutRun[]
  offer                   Offer?
  invitations             Invitation[]
  messages                Message[]
  conversions             Conversion[]
}

model Membership {
  id            String       @id @default(cuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  status        String       @default("ACTIVE") // ACTIVE | REMOVED
  /// Code du lien traqué personnel : /r/<trackingCode>
  trackingCode  String       @unique
  payoutMethod  String? // IBAN | PAYPAL
  payoutDetails String?
  createdAt     DateTime     @default(now())
  clips         Clip[]
  reservations  Moment[]
  clicks        LinkClick[]
  payouts       Payout[]
  conversions   Conversion[]

  @@unique([workspaceId, userId])
}

/// Contenu long (épisode, live, interview, démo produit) dans lequel les clippeurs piochent.
model Source {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  url         String
  notes       String?
  createdAt   DateTime  @default(now())
  moments     Moment[]
}

/// Un passage à clipper. Un clippeur le réserve pour éviter les doublons.
model Moment {
  id           String      @id @default(cuid())
  sourceId     String
  source       Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title        String
  startSec     Int
  endSec       Int
  notes        String?
  reservedById String?
  reservedBy   Membership? @relation(fields: [reservedById], references: [id])
  reservedAt   DateTime?
  createdAt    DateTime    @default(now())
  clips        Clip[]
}

model Clip {
  id                String         @id @default(cuid())
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membershipId      String
  membership        Membership     @relation(fields: [membershipId], references: [id])
  momentId          String?
  moment            Moment?        @relation(fields: [momentId], references: [id])
  url               String
  platform          String // YOUTUBE | TIKTOK | INSTAGRAM | X
  externalId        String
  /// PENDING (en vérification) | FLAGGED (suspect) | APPROVED | REJECTED
  status            String         @default("PENDING")
  views             Int            @default(0)
  likes             Int            @default(0)
  comments          Int            @default(0)
  shares            Int            @default(0)
  postedAt          DateTime?
  lastFetchedAt     DateTime?
  statsSource       String? // API | DEMO | MANUAL
  fraudScore        Int            @default(0)
  /// JSON : [{ code, label, points }]
  fraudReasons      String         @default("[]")
  /// Le créateur a validé le clip malgré un signalement
  approvedOverride  Boolean        @default(false)
  /// true : la vidéo est bien sur le compte connecté du clippeur ; false : elle n'y est pas ; null : non vérifiable
  ownershipVerified Boolean?
  /// Part des vues venant des pays francophones ciblés (0..1), si la plateforme la fournit
  audienceShare     Float?
  /// Comment la propriété a été prouvée : OAUTH (compte connecté) | CODE (code dans la description)
  ownershipMethod   String?
  /// Aperçu de la vidéo (miniature, légende, compte qui l'a publiée)
  thumbnailUrl      String?
  caption           String?
  authorHandle      String?
  paidViews         Int            @default(0)
  paidCents         Int            @default(0)
  createdAt         DateTime       @default(now())
  snapshots         ViewSnapshot[]
  payoutLines       PayoutLine[]

  @@unique([workspaceId, platform, externalId])
}

model ViewSnapshot {
  id         String   @id @default(cuid())
  clipId     String
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  views      Int
  likes      Int
  comments   Int
  shares     Int
  capturedAt DateTime @default(now())

  @@index([clipId, capturedAt])
}

model LinkClick {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  visitorHash  String
  /// IOS | ANDROID | DESKTOP
  device       String?
  createdAt    DateTime   @default(now())

  @@index([membershipId, createdAt])
}

model PayoutRun {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  totalCents  Int
  createdAt   DateTime  @default(now())
  payouts     Payout[]
}

model Payout {
  id           String       @id @default(cuid())
  runId        String
  run          PayoutRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership   @relation(fields: [membershipId], references: [id])
  amountCents  Int
  views        Int
  status       String       @default("PENDING") // PENDING | PAID
  paidAt       DateTime?
  lines        PayoutLine[]
}

model PayoutLine {
  id          String @id @default(cuid())
  payoutId    String
  payout      Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  clipId      String
  clip        Clip   @relation(fields: [clipId], references: [id])
  views       Int
  amountCents Int
}

/// Discussion d'équipe (salons type Discord) : créateur + clippeurs actifs.
model Message {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     String // general | annonces | entraide
  body        String
  createdAt   DateTime  @default(now())

  @@index([workspaceId, channel, createdAt])
}

/// Conversion attribuée à un clippeur : téléchargement, inscription ou achat.
model Conversion {
  id           String     @id @default(cuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  kind         String // INSTALL | SIGNUP | PURCHASE
  quantity     Int        @default(1)
  source       String // POSTBACK | MANUAL
  /// identifiant de l'événement côté produit, pour ne pas compter deux fois la même conversion
  externalId   String?
  note         String?
  createdAt    DateTime   @default(now())

  @@unique([workspaceId, externalId])
  @@index([membershipId, createdAt])
}
